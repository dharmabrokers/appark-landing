# ── Lead delivery — configure AT LEAST ONE channel, ideally both ──
# 1) n8n webhooks (optional)
N8N_EARLY_ACCESS_WEBHOOK_URL=
N8N_SPONSOR_WEBHOOK_URL=

# 2) Email fallback via SMTP (recommended — a lead NEVER gets lost).
#    Hostinger example: host smtp.hostinger.com, port 465 (SSL).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=hola@appark.es
SMTP_PASS=
# Inbox that receives every lead (defaults to SMTP_USER if empty).
LEADS_TO=hola@appark.es

# 3) Supabase — escribe los leads de sponsor directamente en la tabla
#    public.sponsor_leads para que aparezcan en el CRM (pipeline comercial).
#    Usa la anon key pública (la misma que el CRM y la app); la política RLS
#    "Allow public insert on sponsor_leads" (migración 0010) permite el INSERT.
NEXT_PUBLIC_SUPABASE_URL=https://vsxldnwhwaanuvjwnwhl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── App feedback notification (Supabase Database Webhook → this route) ──
# Random string of your choosing. Set the SAME value as a custom header
# (x-webhook-secret) on the Supabase Database Webhook for app_feedback.
SUPABASE_WEBHOOK_SECRET=

# ── Anti-spam (optional; fails open if unset) ──
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Analytics ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-G3MV9DZD72

# ── Alta de comercios con tarjeta (appark.es/alta) ──
# Clave RESTRINGIDA de Stripe (rk_live_... / rk_test_...): solo «Checkout
# Sessions: write». Producción con la real; Preview con la de pruebas.
STRIPE_SECRET_KEY=
# Opcionales. Por defecto, los precios reales y los cupones de 13 meses
# (appark_<tier>_fundador_13m). En Preview hay que poner los de pruebas.
STRIPE_PRICE_BRONZE=
STRIPE_PRICE_SILVER=
STRIPE_PRICE_GOLD=
STRIPE_COUPON_BRONZE=
STRIPE_COUPON_SILVER=
STRIPE_COUPON_GOLD=
# 1 = pedir también la casilla de condiciones de Stripe (necesita la URL de
# las condiciones en Stripe → Settings → Public details).
STRIPE_TOS_CONSENT=
# Opcional: si el panel web del comercio está publicado, botón en /alta/listo.
NEXT_PUBLIC_SPONSOR_PANEL_URL=
